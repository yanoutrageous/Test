{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-exam-bank:question-ir:1.0",
  "title": "QuestionIR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "ir_id",
    "revision_id",
    "question_type",
    "blocks",
    "options",
    "subquestions",
    "figure_revision_ids",
    "answer_blocks",
    "solution_blocks",
    "scoring_points",
    "source_refs",
    "points",
    "design_difficulty",
    "observed_p",
    "expected_time_seconds",
    "observed_item_time_seconds",
    "observed_item_time_source",
    "extensions"
  ],
  "properties": {
    "schema_id": {
      "const": "LOCAL_EXAM_BANK_QUESTION_IR"
    },
    "schema_version": {
      "const": "1.0"
    },
    "ir_id": {
      "$ref": "#/$defs/id"
    },
    "revision_id": {
      "$ref": "#/$defs/id"
    },
    "question_type": {
      "enum": [
        "selection",
        "fill",
        "solution",
        "proof",
        "drawing",
        "additional"
      ]
    },
    "blocks": {
      "$ref": "#/$defs/blocks"
    },
    "options": {
      "type": "array"
    },
    "subquestions": {
      "type": "array"
    },
    "answer_blocks": {
      "$ref": "#/$defs/blocks"
    },
    "solution_blocks": {
      "$ref": "#/$defs/blocks"
    },
    "scoring_points": {
      "type": "array"
    },
    "figure_revision_ids": {
      "$ref": "#/$defs/idList"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1
    },
    "points": {
      "type": "number",
      "minimum": 0
    },
    "design_difficulty": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "observed_p": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "expected_time_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "observed_item_time_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "observed_item_time_source": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9._-]{2,127}$",
      "not": {
        "const": "LATEST"
      }
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^x-[a-z0-9][a-z0-9._-]{0,62}$"
      }
    }
  },
  "x-runtime-validator": "app.ir_contracts.validate_question_ir"
}
